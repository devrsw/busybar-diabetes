# Busy Bar target
BUSYBAR_IP=10.0.4.20

# Provider: nightscout | dexcom
BB_PROVIDER=nightscout
BB_POLL_SECONDS=15
BB_UNIT=mg/dL
BB_DISPLAY_MODE=mgdl

# Thresholds
BB_LOW_THRESHOLD=70
BB_HIGH_THRESHOLD=180
BB_URGENT_LOW_THRESHOLD=55
BB_URGENT_HIGH_THRESHOLD=250
BB_STALE_MINUTES=10

# Optional alert audio and cooldown
BB_ALERT_SOUND_PATH=
BB_ALERT_COOLDOWN_SECONDS=300

# Nightscout settings
NS_BASE_URL=https://your-nightscout.example.com
NS_TOKEN=

# Dexcom Share settings
DEXCOM_USERNAME=
DEXCOM_PASSWORD=
DEXCOM_OUS=true
