{
  "format_version": 1,
  "version": 1,
  "fields": {
    "dexcom": {
      "type": "group",
      "label": "Dexcom Share",
      "fields": {
        "username": {
          "type": "string",
          "label": "Username",
          "description": "Dexcom account username, email or phone (+country code) of the person sharing",
          "default": "",
          "max_length": 128
        },
        "password": {
          "type": "string",
          "label": "Password",
          "default": "",
          "max_length": 128,
          "sensitive": true
        },
        "region": {
          "type": "enum",
          "label": "Region",
          "description": "Where the Dexcom account was created",
          "default": "us",
          "options": [
            { "value": "us", "label": "United States" },
            { "value": "ous", "label": "Outside US" },
            { "value": "jp", "label": "Japan" }
          ]
        }
      }
    },
    "display": {
      "type": "group",
      "label": "Display",
      "fields": {
        "units": {
          "type": "enum",
          "label": "Units",
          "default": "mgdl",
          "options": [
            { "value": "mgdl", "label": "mg/dL" },
            { "value": "mmol", "label": "mmol/L" }
          ]
        },
        "stale_minutes": {
          "type": "integer",
          "label": "Stale after (min)",
          "description": "Grey out the reading when it is older than this",
          "default": 15,
          "min": 5,
          "max": 60,
          "step": 1
        }
      }
    },
    "ranges": {
      "type": "group",
      "label": "Ranges (mg/dL)",
      "fields": {
        "urgent_low": { "type": "integer", "label": "Urgent low", "default": 55, "min": 40, "max": 100, "step": 1 },
        "low": { "type": "integer", "label": "Low", "default": 70, "min": 50, "max": 150, "step": 1 },
        "high": { "type": "integer", "label": "High", "default": 180, "min": 120, "max": 300, "step": 1 },
        "urgent_high": { "type": "integer", "label": "Urgent high", "default": 250, "min": 150, "max": 400, "step": 1 },
        "blink_urgent": {
          "type": "boolean",
          "label": "Blink LED when urgent",
          "default": true
        }
      }
    },
    "colors": {
      "type": "group",
      "label": "Colors",
      "fields": {
        "urgent_low": { "type": "color", "label": "Urgent low", "default": "#FF0000" },
        "low": { "type": "color", "label": "Low", "default": "#FF6000" },
        "in_range": { "type": "color", "label": "In range", "default": "#00FF30" },
        "high": { "type": "color", "label": "High", "default": "#FFC000" },
        "urgent_high": { "type": "color", "label": "Urgent high", "default": "#FF3000" }
      }
    }
  }
}
